# Copy to .env (never commit it) or export these in your shell before `npm run dev` / `npm start`.
# Every variable is optional. Without a key, choose the MOCK provider in the app, or paste a key in the app's AI settings.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI proxy, OpenRouter, a local server such as Ollama's /v1).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Server port (production build and API). Dev client runs on 5173 and proxies to this port.
PORT=1234
# Artificial latency for the MOCK provider (ms), so previews feel like a real model.
MOCK_LATENCY_MS=700
# Request timeout for the real provider (ms, 1000 to 600000). It covers the whole answer, not only its first byte.
# Numeric variables with an invalid value (e.g. "60s") are ignored with a warning, and the default is used.
LLM_TIMEOUT_MS=60000
# Where rooms and exports are saved. Use "none" to keep everything in memory.
DATA_DIR=data
