{
  "name": "collaborative-directgpt",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative DirectGPT: direct manipulation for multi-user AI-assisted document editing (built on DirectGPT, CHI 2024)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "start": "npm run build && npm run serve",
    "serve": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "analyze": "tsx scripts/analyze.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.1",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "diff": "^5.1.0",
    "lib0": "^0.2.114",
    "openai": "^4.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^18.2.0",
    "react-github-corner": "^2.5.0",
    "react-markdown": "^8.0.7",
    "react-medium-image-zoom": "^5.1.8",
    "react-router-dom": "^6.14.1",
    "react-syntax-highlighter": "^15.5.0",
    "react-tabs": "^6.0.2",
    "tsx": "^4.20.0",
    "ws": "^8.18.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.27",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/diff": "^5.0.3",
    "@types/node": "^20.3.2",
    "@types/prismjs": "^1.26.0",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@types/react-syntax-highlighter": "^15.5.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "prismjs": "$prismjs"
  }
}
